Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache retire parfois l'en-tête Authorization avant PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Tout ce qui n'est pas un fichier existant (ex. /uploads/xxx.png) passe par index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Limites d'upload (mod_php). Pour PHP-FPM, c'est .user.ini ou php.ini.
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
